# Copy to .env. Read by runserver and both docker compose files (env_file).
# Production (docker-compose.prod.yml, behind CloudFront): set ALLOWED_HOSTS to the
# host CloudFront sends (your domain if its origin request policy forwards Host, else
# the origin's name), CSRF_TRUSTED_ORIGINS=https://your.domain, and keep
# SECURE_SSL_REDIRECT=false: CloudFront redirects viewers to HTTPS itself.
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8000
SECURE_SSL_REDIRECT=false
# Docker service name; for runserver add "127.0.0.1 redis" to /etc/hosts
REDIS_URL=redis://redis:6379
LOG_FORMAT=json
LOG_LEVEL=INFO
API_RATE_LIMIT=1000/hour
# Where the Vite dev server proxies /api (docker compose service name)
BACKEND_URL=http://backend:8000
# Frontend: Maps JavaScript API + Places API (New) browser key, restricted by HTTP referrer
GOOGLE_MAPS_API_KEY=
# Backend: Routes API server key, restricted by IP address (never sent to the browser)
GOOGLE_ROUTES_API_KEY=

# --- Production only (docker-compose.prod.yml) ---
# Port CloudFront connects to (plain HTTP)
WEB_PORT=80
# Gunicorn worker processes (default: 2 x CPUs + 1)
# GUNICORN_WORKERS=3
# Redis memory cap; keys that expire are evicted first when full
REDIS_MAXMEMORY=256mb
CELERY_CONCURRENCY=2
