# Read by nginx-http, nginx-https and certbot (docker-compose.prod.yml).
# BASE_DOMAIN fills server_name and the Let's Encrypt paths in the templates;
# certbot requests a certificate for BASE_DOMAIN and www.BASE_DOMAIN.
# FRONTEND_URL: where the React app is served (CloudFront, see deploy_web_s3.sh);
# nginx-https sends every non-API request there. No trailing slash.
ADMIN_EMAIL=andreytsuzuki@gmail.com
BASE_DOMAIN=nanithefuck.com.br
FRONTEND_URL=https://d1bg1gulylxih6.cloudfront.net
